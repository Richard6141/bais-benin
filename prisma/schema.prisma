// Schéma Prisma de BAIS — Bénin Agricultural Intelligence System.
//
// Conventions (docs/04-modele-donnees.md) :
// - tables et colonnes en snake_case via @map, identifiants UUID v7 ;
// - chaque table métier porte la provenance : source_id, source_date, reliability ;
// - suppression logique par archived_at, jamais de DELETE sur les entités du registre ;
// - les géométries sont des colonnes PostGIS déclarées Unsupported : Prisma les crée,
//   les requêtes spatiales passent par src/database/sql (SQL paramétré + Zod).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Énumérations
// ---------------------------------------------------------------------------

// Niveau de fiabilité d'une donnée (docs/08 §1).
enum Reliability {
  DECLARED
  AGENT_VERIFIED
  FIELD_VERIFIED
  OFFICIAL
  ESTIMATED
  SYNTHETIC
}

enum DataSourceKind {
  OFFICIAL
  FIELD
  PUBLIC_OPEN_DATA
  SENSOR
  MODEL
  SYNTHETIC
}

enum RainfallRegime {
  BIMODAL
  UNIMODAL
}

enum CropCategory {
  CEREAL
  ROOT_TUBER
  LEGUME
  CASH_CROP
  VEGETABLE
  FRUIT
  OILSEED
}

enum CropCycle {
  ANNUAL
  PERENNIAL
  GATHERED
}

enum TradeUnit {
  KG
  T
  BAG_100KG
  BAG_50KG
  BUNCH
  HEAP
  BASIN
}

enum CampaignStatus {
  PLANNED
  OPEN
  CLOSED
}

enum SubSeason {
  MAIN_RAINY
  SHORT_RAINY
  DRY
  ANNUAL
}

enum Role {
  ADMIN_STATE
  AGENT_AGRICULTURE
  FARMER
  COOPERATIVE
  BUYER
}

// Périmètre sur lequel un rôle s'applique (docs/06 §3).
enum ScopeType {
  NATIONAL
  DEPARTEMENT
  COMMUNE
  ORGANIZATION
  SELF
}

enum Gender {
  M
  F
  UNSPECIFIED
}

enum LandTenure {
  OWNED
  RENTED
  FAMILY
  SHARED
  UNKNOWN
}

enum FarmActivity {
  CROPS
  MIXED
  LIVESTOCK_DOMINANT
}

enum VerificationStatus {
  DECLARED
  AGENT_VERIFIED
  FIELD_VERIFIED
  DISPUTED
}

enum ParcelCaptureMethod {
  GPS_WALK
  MAP_DRAW
  DECLARED_ONLY
  // Contour proposé depuis l'image Sentinel-2 et validé par l'agent (ADR-0016, phase 3).
  SATELLITE_ASSISTED
}

enum IrrigationType {
  NONE
  MANUAL
  DRIP
  FLOOD
}

enum HarvestUnit {
  KG
  T
  BAG_100KG
  BAG_50KG
  BUNCH
  HEAP
  BASIN
}

enum DeclaredBy {
  FARMER
  AGENT
}

enum FieldVerificationKind {
  DESK_REVIEW
  FIELD_VISIT
  REMOTE_SENSING
}

enum FieldVerificationOutcome {
  CONFIRMED
  CORRECTED
  REJECTED
}

enum SyncOutcome {
  APPLIED
  DUPLICATE
  REJECTED
  CONFLICT
}

enum CropStage {
  PLANNED
  SOWN
  GROWING
  FLOWERING
  HARVESTED
  FAILED
}

// ---------------------------------------------------------------------------
// Référentiels transverses
// ---------------------------------------------------------------------------

model DataSource {
  id           String         @id
  name         String
  organization String?
  url          String?
  licence      String?
  kind         DataSourceKind
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  departements  Departement[]
  communes      Commune[]
  zones         AgroEcologicalZone[]
  crops         Crop[]
  campaigns     AgriculturalCampaign[]
  farmers       Farmer[]
  farms         Farm[]
  parcels       Parcel[]
  parcelCrops   ParcelCrop[]
  declarations  ProductionDeclaration[]
  verifications FarmVerification[]

  weatherObservations WeatherObservation[]
  vegetationChecks    ParcelVegetationCheck[]
  cropAreaEstimates   CropAreaEstimate[]
  rules               Rule[]
  alerts              Alert[]

  @@map("data_source")
}

// ---------------------------------------------------------------------------
// Territoire
// ---------------------------------------------------------------------------

model AgroEcologicalZone {
  id                    String         @id @default(uuid(7)) @db.Uuid
  code                  String         @unique
  name                  String
  rainfallRegime        RainfallRegime @map("rainfall_regime")
  dominantSystems       String[]       @map("dominant_systems")
  indicativeRainfallMin Int            @map("indicative_rainfall_min_mm")
  indicativeRainfallMax Int            @map("indicative_rainfall_max_mm")
  // Rattachement de phase 1 : un département peut relever de plusieurs zones (docs/08 §3).
  departementCodes      String[]       @map("departement_codes")

  sourceId    String      @map("source_id")
  source      DataSource  @relation(fields: [sourceId], references: [id])
  sourceDate  DateTime    @map("source_date")
  reliability Reliability
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  archivedAt  DateTime?   @map("archived_at")

  communes Commune[]

  @@map("agro_ecological_zone")
}

model Departement {
  id              String                                        @id @default(uuid(7)) @db.Uuid
  // Code ISO 3166-2:BJ, par exemple BJ-DO pour la Donga.
  code            String                                        @unique
  name            String
  chefLieu        String                                        @map("chef_lieu")
  // Identifiant de la géométrie chez geoBoundaries, pour suivre les mises à jour.
  geoboundariesId String?                                       @map("geoboundaries_id")
  geom            Unsupported("geography(MultiPolygon, 4326)")?
  centroid        Unsupported("geography(Point, 4326)")?
  areaKm2         Decimal?                                      @map("area_km2") @db.Decimal(12, 3)

  sourceId    String      @map("source_id")
  source      DataSource  @relation(fields: [sourceId], references: [id])
  sourceDate  DateTime    @map("source_date")
  reliability Reliability
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  archivedAt  DateTime?   @map("archived_at")

  communes       Commune[]
  producerGroups ProducerGroup[]

  @@map("departement")
}

model Commune {
  id                      String                                        @id @default(uuid(7)) @db.Uuid
  // Code stable BJ-<DEP>-<NNN>, indépendant du libellé (docs/08 §2.1).
  code                    String                                        @unique
  name                    String
  // Variantes d'orthographe acceptées en recherche (Sèmè-Podji pour Sèmè-Kpodji).
  aliases                 String[]
  departementId           String                                        @map("departement_id") @db.Uuid
  departement             Departement                                   @relation(fields: [departementId], references: [id])
  zoneId                  String?                                       @map("agro_ecological_zone_id") @db.Uuid
  zone                    AgroEcologicalZone?                           @relation(fields: [zoneId], references: [id])
  geoboundariesId         String?                                       @map("geoboundaries_id")
  geom                    Unsupported("geography(MultiPolygon, 4326)")?
  centroid                Unsupported("geography(Point, 4326)")?
  areaKm2                 Decimal?                                      @map("area_km2") @db.Decimal(12, 3)
  ruralPopulationEstimate Int?                                          @map("rural_population_estimate")

  sourceId    String      @map("source_id")
  source      DataSource  @relation(fields: [sourceId], references: [id])
  sourceDate  DateTime    @map("source_date")
  reliability Reliability
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  archivedAt  DateTime?   @map("archived_at")

  farmers Farmer[]
  farms   Farm[]

  weatherObservations WeatherObservation[]
  ruleEvaluations     RuleEvaluation[]
  alerts              Alert[]

  assistantConversations AssistantConversation[]
  assistantAgentRequests AssistantAgentRequest[]
  fieldReports           FieldReport[]
  assistanceRequests     AssistanceRequest[]
  cropAreaEstimates      CropAreaEstimate[]
  fireDetections         FireDetection[]

  @@index([departementId])
  @@index([zoneId])
  @@map("commune")
}

// ---------------------------------------------------------------------------
// Référentiels agricoles
// ---------------------------------------------------------------------------

model Crop {
  id                 String       @id @default(uuid(7)) @db.Uuid
  code               String       @unique
  nameFr             String       @map("name_fr")
  category           CropCategory
  cycle              CropCycle
  tradeUnit          TradeUnit    @map("trade_unit")
  typicalYieldTPerHa Decimal?     @map("typical_yield_t_per_ha") @db.Decimal(6, 2)
  // Zones où la culture est significative, par ordre d'importance (codes ZAE).
  mainZoneCodes      String[]     @map("main_zone_codes")
  // Fenêtres de semis et de récolte par régime, en numéros de mois : { south: {...}, north: {...} }.
  calendar           Json
  // Couleur fixe dans l'interface pour les cultures majeures (docs/07 §3).
  colorHex           String?      @map("color_hex")

  sourceId    String      @map("source_id")
  source      DataSource  @relation(fields: [sourceId], references: [id])
  sourceDate  DateTime    @map("source_date")
  reliability Reliability
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  archivedAt  DateTime?   @map("archived_at")

  parcelCrops      ParcelCrop[]
  vegetationChecks ParcelVegetationCheck[]
  producerGroups   ProducerGroup[]

  @@map("crop")
}

// Campagne agricole nationale : du 1er avril au 31 mars (docs/08 §5).
model AgriculturalCampaign {
  id        String         @id @default(uuid(7)) @db.Uuid
  code      String         @unique
  startYear Int            @unique @map("start_year")
  startsOn  DateTime       @map("starts_on") @db.Date
  endsOn    DateTime       @map("ends_on") @db.Date
  status    CampaignStatus @default(PLANNED)

  sourceId    String      @map("source_id")
  source      DataSource  @relation(fields: [sourceId], references: [id])
  sourceDate  DateTime    @map("source_date")
  reliability Reliability
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  archivedAt  DateTime?   @map("archived_at")

  parcelCrops       ParcelCrop[]
  vegetationChecks  ParcelVegetationCheck[]
  cropAreaEstimates CropAreaEstimate[]
  producerGroups    ProducerGroup[]

  @@map("agricultural_campaign")
}

// ---------------------------------------------------------------------------
// Identité et accès (les mécanismes de connexion arrivent à l'étape 3)
// ---------------------------------------------------------------------------

// Table des comptes gérée par better-auth (ADR-0010). Les noms de champs sont ceux
// qu'attend la bibliothèque ; les colonnes restent en snake_case.
model User {
  id                      String    @id @default(uuid(7)) @db.Uuid
  name                    String    @map("display_name")
  // better-auth exige un e-mail unique : les comptes créés par téléphone reçoivent une
  // adresse technique <numéro>@telephone.bais.invalid, jamais affichée.
  email                   String    @unique @db.Citext
  emailVerified           Boolean   @default(false) @map("email_verified")
  image                   String?
  // Identifiant principal des agriculteurs et des agents : +229 01 XX XX XX XX.
  phoneNumber             String?   @unique @map("phone_e164")
  phoneNumberVerified     Boolean?  @map("phone_verified")
  twoFactorEnabled        Boolean?  @default(false) @map("two_factor_enabled")
  preferredLocale         String?   @default("fr") @map("preferred_locale")
  status                  String?   @default("ACTIVE")
  // NPI (ANIP) : jamais en clair. L'index HMAC sert à l'unicité, le chiffré à la restitution
  // habilitée (format versionné, voir lib/crypto/npi.ts).
  npiIndex                Bytes?    @unique @map("npi_index")
  npiCiphertext           String?   @map("npi_ciphertext")
  npiStatus               NpiStatus @default(NONE) @map("npi_status")
  npiVerifiedAt           DateTime? @map("npi_verified_at")
  npiVerificationProvider String?   @map("npi_verification_provider")
  lastLoginAt             DateTime? @map("last_login_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  archivedAt              DateTime? @map("archived_at")

  sessions           Session[]
  accounts           Account[]
  twoFactors         TwoFactor[]
  roles              RoleAssignment[]   @relation("assignments")
  grantedRoles       RoleAssignment[]   @relation("grants")
  auditEntries       AuditLog[]
  farmer             Farmer?
  registeredFarms    Farm[]             @relation("registeredBy")
  verifiedFarms      Farm[]             @relation("verifiedBy")
  fieldVerifications FarmVerification[]

  assistantConversations AssistantConversation[]
  assistantFeedback      AssistantFeedback[]
  handledAgentRequests   AssistantAgentRequest[]

  fieldReports         FieldReport[] @relation("fieldReportAuthor")
  reviewedFieldReports FieldReport[] @relation("fieldReportReviewer")

  assistanceRequests        AssistanceRequest[] @relation("assistanceRequester")
  handledAssistanceRequests AssistanceRequest[] @relation("assistanceHandler")

  publishedRankings PublishedRanking[] @relation("rankingPublisher")
  withdrawnRankings PublishedRanking[] @relation("rankingWithdrawer")

  createdProducerGroups ProducerGroup[]        @relation("producerGroupCreator")
  producerGroupMessages ProducerGroupMessage[] @relation("producerGroupMessageSender")

  @@map("user")
}

enum NpiStatus {
  NONE
  PENDING
  VERIFIED
  MISMATCH
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  // Argon2id pour le fournisseur "credential" (comptes institutionnels).
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("auth_verification")
}

model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until")

  @@index([secret])
  @@index([userId])
  @@map("auth_two_factor")
}

model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("auth_rate_limit")
}

// Journal d'audit en ajout seul (docs/06 §6) : connexions, rôles, révélations de NPI…
model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at")
  actorId       String?  @map("actor_id") @db.Uuid
  // La trace survit à la suppression du compte : l'acteur passe simplement à nul.
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String
  resourceType  String?  @map("resource_type")
  resourceId    String?  @map("resource_id")
  outcome       String   @default("SUCCESS")
  details       Json?
  ipHash        String?  @map("ip_hash")
  userAgent     String?  @map("user_agent")
  correlationId String?  @map("correlation_id")

  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_log")
}

model RoleAssignment {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation("assignments", fields: [userId], references: [id], onDelete: Cascade)
  role        Role
  scopeType   ScopeType @map("scope_type")
  // Identifiant du territoire ou de l'organisation ciblé ; nul pour NATIONAL et SELF.
  scopeId     String?   @map("scope_id") @db.Uuid
  grantedById String?   @map("granted_by_id") @db.Uuid
  grantedBy   User?     @relation("grants", fields: [grantedById], references: [id])
  grantedAt   DateTime  @default(now()) @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")

  @@index([userId, role])
  @@index([scopeType, scopeId])
  @@map("role_assignment")
}

// ---------------------------------------------------------------------------
// Registre national
// ---------------------------------------------------------------------------

model Farmer {
  id            String  @id @default(uuid(7)) @db.Uuid
  code          String  @unique
  // Un agriculteur peut exister sans compte : il est enregistré par un agent.
  userId        String? @unique @map("user_id") @db.Uuid
  user          User?   @relation(fields: [userId], references: [id])
  firstName     String  @map("first_name")
  lastName      String  @map("last_name")
  gender        Gender  @default(UNSPECIFIED)
  // Année seulement : minimisation des données personnelles.
  birthYear     Int?    @map("birth_year")
  phoneE164     String? @map("phone_e164")
  communeId     String  @map("commune_id") @db.Uuid
  commune       Commune @relation(fields: [communeId], references: [id])
  village       String?
  householdSize Int?    @map("household_size")

  sourceId    String      @map("source_id")
  source      DataSource  @relation(fields: [sourceId], references: [id])
  sourceDate  DateTime    @map("source_date")
  reliability Reliability
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  archivedAt  DateTime?   @map("archived_at")

  farms Farm[]

  channelConsents ChannelConsent[]

  notifications  FarmerNotification[]
  rankingConsent RankingConsent?
  rankingEntries PublishedRankingEntry[]
  producerGroups ProducerGroupMember[]

  @@index([communeId])
  @@index([lastName, firstName])
  @@map("farmer")
}

model Farm {
  id                 String                                 @id @default(uuid(7)) @db.Uuid
  code               String                                 @unique
  farmerId           String                                 @map("farmer_id") @db.Uuid
  farmer             Farmer                                 @relation(fields: [farmerId], references: [id])
  name               String?
  communeId          String                                 @map("commune_id") @db.Uuid
  commune            Commune                                @relation(fields: [communeId], references: [id])
  village            String?
  location           Unsupported("geography(Point, 4326)")?
  declaredAreaHa     Decimal                                @map("declared_area_ha") @db.Decimal(10, 3)
  computedAreaHa     Decimal?                               @map("computed_area_ha") @db.Decimal(10, 3)
  tenure             LandTenure                             @default(UNKNOWN)
  mainActivity       FarmActivity                           @default(CROPS) @map("main_activity")
  verificationStatus VerificationStatus                     @default(DECLARED) @map("verification_status")
  verifiedAt         DateTime?                              @map("verified_at")
  verifiedById       String?                                @map("verified_by_id") @db.Uuid
  verifiedBy         User?                                  @relation("verifiedBy", fields: [verifiedById], references: [id])
  registeredById     String?                                @map("registered_by_id") @db.Uuid
  registeredBy       User?                                  @relation("registeredBy", fields: [registeredById], references: [id])
  // Verrou optimiste pour la synchronisation hors-ligne.
  version            Int                                    @default(1)

  sourceId    String      @map("source_id")
  source      DataSource  @relation(fields: [sourceId], references: [id])
  sourceDate  DateTime    @map("source_date")
  reliability Reliability
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  archivedAt  DateTime?   @map("archived_at")

  parcels       Parcel[]
  verifications FarmVerification[]
  events        FarmEvent[]

  alertRecipients AlertRecipient[]
  fieldReports    FieldReport[]
  assistance      AssistanceRequest[]

  assistantConversations AssistantConversation[]

  @@index([communeId, verificationStatus])
  @@index([farmerId])
  // Ancienneté des exploitations déclarées non vérifiées (qualité des données, D2).
  @@index([verificationStatus, createdAt])
  @@map("farm")
}

model Parcel {
  id             String                                   @id @default(uuid(7)) @db.Uuid
  code           String                                   @unique
  farmId         String                                   @map("farm_id") @db.Uuid
  farm           Farm                                     @relation(fields: [farmId], references: [id])
  geom           Unsupported("geography(Polygon, 4326)")?
  centroid       Unsupported("geography(Point, 4326)")?
  declaredAreaHa Decimal                                  @map("declared_area_ha") @db.Decimal(10, 3)
  computedAreaHa Decimal?                                 @map("computed_area_ha") @db.Decimal(10, 3)
  captureMethod  ParcelCaptureMethod                      @default(DECLARED_ONLY) @map("capture_method")
  gpsAccuracyM   Decimal?                                 @map("gps_accuracy_m") @db.Decimal(6, 1)
  irrigation     IrrigationType                           @default(NONE)
  soilType       String?                                  @map("soil_type")
  version        Int                                      @default(1)

  sourceId    String      @map("source_id")
  source      DataSource  @relation(fields: [sourceId], references: [id])
  sourceDate  DateTime    @map("source_date")
  reliability Reliability
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  archivedAt  DateTime?   @map("archived_at")

  crops            ParcelCrop[]
  vegetationChecks ParcelVegetationCheck[]
  verifications    FarmVerification[]
  fieldReports     FieldReport[]

  @@index([farmId])
  @@map("parcel")
}

// Culture pratiquée sur une parcelle pendant une campagne et une sous-saison.
model ParcelCrop {
  id                  String               @id @default(uuid(7)) @db.Uuid
  parcelId            String               @map("parcel_id") @db.Uuid
  parcel              Parcel               @relation(fields: [parcelId], references: [id])
  cropId              String               @map("crop_id") @db.Uuid
  crop                Crop                 @relation(fields: [cropId], references: [id])
  campaignId          String               @map("campaign_id") @db.Uuid
  campaign            AgriculturalCampaign @relation(fields: [campaignId], references: [id])
  subSeason           SubSeason            @default(MAIN_RAINY) @map("sub_season")
  areaHa              Decimal              @map("area_ha") @db.Decimal(10, 3)
  sowingDate          DateTime?            @map("sowing_date") @db.Date
  expectedHarvestDate DateTime?            @map("expected_harvest_date") @db.Date
  stage               CropStage            @default(PLANNED)
  variety             String?

  sourceId    String      @map("source_id")
  source      DataSource  @relation(fields: [sourceId], references: [id])
  sourceDate  DateTime    @map("source_date")
  reliability Reliability
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  archivedAt  DateTime?   @map("archived_at")

  declarations ProductionDeclaration[]

  @@unique([parcelId, cropId, campaignId, subSeason])
  @@index([cropId, campaignId])
  @@map("parcel_crop")
}

// Déclaration de récolte sur une culture de campagne (docs/04 §6).
model ProductionDeclaration {
  id                 String      @id @default(uuid(7)) @db.Uuid
  parcelCropId       String      @map("parcel_crop_id") @db.Uuid
  parcelCrop         ParcelCrop  @relation(fields: [parcelCropId], references: [id])
  declaredQuantity   Decimal     @map("declared_quantity") @db.Decimal(12, 2)
  unit               HarvestUnit
  // Quantité normalisée par le facteur de l'unité : c'est elle qu'agrègent les indicateurs.
  quantityKg         Decimal     @map("quantity_kg") @db.Decimal(14, 2)
  declaredOn         DateTime    @map("declared_on") @db.Date
  declaredBy         DeclaredBy  @map("declared_by")
  declaredByUserId   String?     @map("declared_by_user_id") @db.Uuid
  lossesPct          Decimal?    @map("losses_pct") @db.Decimal(5, 2)
  lossCause          String?     @map("loss_cause")
  priceHintFcfaPerKg Decimal?    @map("price_hint_fcfa_per_kg") @db.Decimal(10, 2)

  sourceId    String      @map("source_id")
  source      DataSource  @relation(fields: [sourceId], references: [id])
  sourceDate  DateTime    @map("source_date")
  reliability Reliability
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  archivedAt  DateTime?   @map("archived_at")

  @@index([parcelCropId])
  @@map("production_declaration")
}

// Visite ou contrôle qui fait évoluer le statut de vérification d'une exploitation.
model FarmVerification {
  id                String                                 @id @default(uuid(7)) @db.Uuid
  farmId            String                                 @map("farm_id") @db.Uuid
  farm              Farm                                   @relation(fields: [farmId], references: [id])
  parcelId          String?                                @map("parcel_id") @db.Uuid
  parcel            Parcel?                                @relation(fields: [parcelId], references: [id])
  kind              FieldVerificationKind
  outcome           FieldVerificationOutcome
  notes             String?
  identityConfirmed Boolean                                @default(false) @map("identity_confirmed")
  visitedAt         DateTime                               @map("visited_at")
  gpsPoint          Unsupported("geography(Point, 4326)")? @map("gps_point")
  agentId           String?                                @map("agent_id") @db.Uuid
  agent             User?                                  @relation(fields: [agentId], references: [id])

  sourceId    String      @map("source_id")
  source      DataSource  @relation(fields: [sourceId], references: [id])
  sourceDate  DateTime    @map("source_date")
  reliability Reliability
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([farmId, visitedAt])
  // Couverture terrain par agent (fiche commune C3, qualité D3).
  @@index([agentId, visitedAt])
  @@map("farm_verification")
}

// Fil d'activité lisible d'une exploitation, alimenté par les événements de domaine.
model FarmEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  farmId     String   @map("farm_id") @db.Uuid
  farm       Farm     @relation(fields: [farmId], references: [id])
  kind       String
  payload    Json?
  actorId    String?  @map("actor_id") @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([farmId, occurredAt])
  @@map("farm_event")
}

// Journal des commandes reçues des appareils hors ligne (ADR-0005) : la clé d'idempotence
// garantit qu'un lot rejoué ne s'applique qu'une fois.
model SyncCommand {
  id              String      @id @db.Uuid
  idempotencyKey  String      @unique @map("idempotency_key")
  deviceId        String      @map("device_id")
  userId          String      @map("user_id") @db.Uuid
  commandType     String      @map("command_type")
  payload         Json
  clientCreatedAt DateTime    @map("client_created_at")
  receivedAt      DateTime    @default(now()) @map("received_at")
  appliedAt       DateTime?   @map("applied_at")
  outcome         SyncOutcome
  result          Json?

  @@index([userId, receivedAt])
  @@map("sync_command")
}

// ---------------------------------------------------------------------------
// Monitoring agricole (étape 6, docs/04 §7, docs/modules/monitoring-parcours-ux.md §4)
// ---------------------------------------------------------------------------

enum WeatherKind {
  OBSERVED
  FORECAST
  REANALYSIS
}

enum AlertSeverity {
  INFO
  WATCH
  WARNING
  CRITICAL
}

enum AlertCategory {
  WATER_STRESS
  FLOOD
  HEAT
  PEST
  MARKET
  ADMIN
  CROP_DISEASE
  ANIMAL_DISEASE
  FIRE
}

enum RuleTarget {
  COMMUNE
  FARM
}

enum AlertStatus {
  ACTIVE
  RESOLVED
  EXPIRED
  SUPERSEDED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
  SMS
  RELAY
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  RELAYED
  SKIPPED
}

enum ConsentMethod {
  AGENT_FORM
  OTP
  WHATSAPP_REPLY
}

enum IngestionStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

// Journée météo par commune (centroïde). Une prévision est identifiée par sa date d'émission :
// la prévision du jour J émise la veille et celle émise le jour même coexistent.
model WeatherObservation {
  id                  String      @id @default(uuid(7)) @db.Uuid
  communeId           String      @map("commune_id") @db.Uuid
  commune             Commune     @relation(fields: [communeId], references: [id])
  observedOn          DateTime    @map("observed_on") @db.Date
  kind                WeatherKind
  issuedOn            DateTime    @map("issued_on") @db.Date
  tempMaxC            Decimal?    @map("temp_max_c") @db.Decimal(4, 1)
  tempMinC            Decimal?    @map("temp_min_c") @db.Decimal(4, 1)
  precipitationMm     Decimal?    @map("precipitation_mm") @db.Decimal(6, 1)
  et0Mm               Decimal?    @map("et0_mm") @db.Decimal(5, 2)
  relativeHumidityPct Decimal?    @map("relative_humidity_pct") @db.Decimal(5, 1)
  windKmh             Decimal?    @map("wind_kmh") @db.Decimal(5, 1)
  soilMoisturePct     Decimal?    @map("soil_moisture_pct") @db.Decimal(5, 2)
  sourceId            String      @map("source_id")
  source              DataSource  @relation(fields: [sourceId], references: [id])
  reliability         Reliability
  ingestionRunId      String?     @map("ingestion_run_id") @db.Uuid
  fetchedAt           DateTime    @default(now()) @map("fetched_at")

  @@unique([communeId, observedOn, kind, sourceId, issuedOn])
  @@index([communeId, observedOn])
  @@map("weather_observation")
}

// Règle d'alerte versionnée : une modification crée une nouvelle ligne (même code, version + 1).
model Rule {
  id            String        @id @default(uuid(7)) @db.Uuid
  code          String
  version       Int           @default(1)
  name          String
  description   String
  severity      AlertSeverity
  category      AlertCategory
  target        RuleTarget    @default(COMMUNE)
  definition    Json
  messageFr     String        @map("message_fr")
  messageShort  String        @map("message_short") @db.VarChar(160)
  adviceFr      String        @map("advice_fr")
  cooldownHours Int           @default(72) @map("cooldown_hours")
  enabled       Boolean       @default(true)
  supersedesId  String?       @map("supersedes_id") @db.Uuid
  createdById   String?       @map("created_by_id") @db.Uuid
  sourceId      String        @map("source_id")
  source        DataSource    @relation(fields: [sourceId], references: [id])
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  evaluations RuleEvaluation[]
  alerts      Alert[]
  simulations SimulationRun[]

  @@unique([code, version])
  @@index([enabled])
  @@map("rule")
}

model RuleEvaluation {
  id                 String         @id @default(uuid(7)) @db.Uuid
  ruleId             String         @map("rule_id") @db.Uuid
  rule               Rule           @relation(fields: [ruleId], references: [id])
  communeId          String         @map("commune_id") @db.Uuid
  commune            Commune        @relation(fields: [communeId], references: [id])
  referenceDate      DateTime       @map("reference_date") @db.Date
  evaluatedAt        DateTime       @default(now()) @map("evaluated_at")
  matched            Boolean
  indicatorsSnapshot Json           @map("indicators_snapshot")
  trace              Json
  missing            String[]
  dataStale          Boolean        @default(false) @map("data_stale")
  simulationId       String?        @map("simulation_id") @db.Uuid
  simulation         SimulationRun? @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  alertId            String?        @map("alert_id") @db.Uuid

  @@index([ruleId, communeId, referenceDate])
  @@index([simulationId])
  @@map("rule_evaluation")
}

model Alert {
  id                   String        @id @default(uuid(7)) @db.Uuid
  ruleId               String        @map("rule_id") @db.Uuid
  rule                 Rule          @relation(fields: [ruleId], references: [id])
  ruleVersion          Int           @map("rule_version")
  severity             AlertSeverity
  category             AlertCategory
  title                String
  messageFr            String        @map("message_fr")
  messageShort         String        @map("message_short") @db.VarChar(160)
  adviceFr             String        @map("advice_fr")
  communeId            String        @map("commune_id") @db.Uuid
  commune              Commune       @relation(fields: [communeId], references: [id])
  affectedFarmCount    Int           @default(0) @map("affected_farm_count")
  affectedAreaHa       Decimal       @default(0) @map("affected_area_ha") @db.Decimal(12, 2)
  indicators           Json
  trace                Json
  startsAt             DateTime      @map("starts_at")
  endsAt               DateTime?     @map("ends_at")
  status               AlertStatus   @default(ACTIVE)
  raisedByEvaluationId String?       @map("raised_by_evaluation_id") @db.Uuid
  supersededById       String?       @map("superseded_by_id") @db.Uuid
  resolvedReason       String?       @map("resolved_reason")
  resolvedById         String?       @map("resolved_by_id") @db.Uuid
  sourceId             String        @map("source_id")
  source               DataSource    @relation(fields: [sourceId], references: [id])
  sourceDate           DateTime      @map("source_date")
  reliability          Reliability
  // Foyer levé sur des signalements non vérifiés (ADR-0015) : visible des agents et du ministère,
  // diffusé aux producteurs seulement quand un agent confirme un signalement du foyer.
  awaitingConfirmation Boolean       @default(false) @map("awaiting_confirmation")
  releasedAt           DateTime?     @map("released_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  recipients AlertRecipient[]

  @@index([communeId, status])
  @@index([status, severity])
  @@index([ruleId, communeId, startsAt])
  @@map("alert")
}

// Destinataire d'une alerte sur un canal. La ligne est figée à la création de l'alerte.
model AlertRecipient {
  id                String              @id @default(uuid(7)) @db.Uuid
  alertId           String              @map("alert_id") @db.Uuid
  alert             Alert               @relation(fields: [alertId], references: [id], onDelete: Cascade)
  farmId            String?             @map("farm_id") @db.Uuid
  farm              Farm?               @relation(fields: [farmId], references: [id])
  userId            String?             @map("user_id") @db.Uuid
  phoneE164         String?             @map("phone_e164")
  channel           NotificationChannel
  status            DeliveryStatus      @default(PENDING)
  providerMessageId String?             @map("provider_message_id")
  failureReason     String?             @map("failure_reason")
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime?           @map("next_attempt_at")
  sentAt            DateTime?           @map("sent_at")
  deliveredAt       DateTime?           @map("delivered_at")
  acknowledgedAt    DateTime?           @map("acknowledged_at")
  relayedById       String?             @map("relayed_by_id") @db.Uuid
  relayMode         String?             @map("relay_mode")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@unique([alertId, farmId, userId, channel])
  @@index([status, nextAttemptAt])
  @@index([userId, acknowledgedAt])
  @@map("alert_recipient")
}

// Consentement d'un producteur à être prévenu par un canal (APDP, exigence wapy.pro).
model ChannelConsent {
  id          String              @id @default(uuid(7)) @db.Uuid
  farmerId    String              @map("farmer_id") @db.Uuid
  farmer      Farmer              @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  channel     NotificationChannel
  granted     Boolean
  grantedAt   DateTime?           @map("granted_at")
  revokedAt   DateTime?           @map("revoked_at")
  method      ConsentMethod
  evidence    String?
  // Version du texte accepté (preuve APDP) ; nulle pour un accord antérieur au suivi des versions.
  textVersion String?             @map("text_version")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@unique([farmerId, channel])
  @@map("channel_consent")
}

model SimulationRun {
  id              String          @id @default(uuid(7)) @db.Uuid
  ruleId          String?         @map("rule_id") @db.Uuid
  rule            Rule?           @relation(fields: [ruleId], references: [id])
  draftDefinition Json?           @map("draft_definition")
  fromDate        DateTime        @map("from_date") @db.Date
  toDate          DateTime        @map("to_date") @db.Date
  requestedById   String?         @map("requested_by_id") @db.Uuid
  status          IngestionStatus @default(RUNNING)
  summary         Json?
  createdAt       DateTime        @default(now()) @map("created_at")
  finishedAt      DateTime?       @map("finished_at")

  evaluations RuleEvaluation[]

  @@map("simulation_run")
}

model IngestionRun {
  id             String          @id @default(uuid(7)) @db.Uuid
  provider       String
  startedAt      DateTime        @default(now()) @map("started_at")
  finishedAt     DateTime?       @map("finished_at")
  status         IngestionStatus @default(RUNNING)
  referenceDate  DateTime        @map("reference_date") @db.Date
  communesOk     Int             @default(0) @map("communes_ok")
  communesFailed Int             @default(0) @map("communes_failed")
  fallback       Boolean         @default(false)
  error          String?

  @@index([startedAt])
  @@map("ingestion_run")
}

// ---------------------------------------------------------------------------
// Assistant agricole (étape 8, docs/modules/assistant-parcours-ux.md)
// ---------------------------------------------------------------------------

enum AssistantDocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

// Issue d'une question : réponse affichée, ou raison pour laquelle elle ne l'a pas été.
enum AssistantOutcome {
  ANSWERED
  LOW_CONFIDENCE
  OFF_TOPIC
  UNSAFE_DOSAGE
  PROVIDER_ERROR
}

enum AssistantRequestStatus {
  OPEN
  HANDLED
}

// Fiche technique du corpus : une source publique citée (organisme, adresse, licence vérifiées
// en ligne), ou une fiche rédigée par l'équipe, marquée démonstration.
model AssistantDocument {
  id              String                  @id @default(uuid(7)) @db.Uuid
  slug            String                  @unique
  title           String
  organization    String
  sourceTitle     String                  @map("source_title")
  sourceUrl       String                  @map("source_url")
  licence         String
  publishedOn     String?                 @map("published_on")
  // Date à laquelle l'adresse et la licence ont été vérifiées en ligne.
  checkedOn       DateTime                @map("checked_on") @db.Date
  demonstration   Boolean                 @default(false)
  crops           String[]                @default([])
  zoneCodes       String[]                @default([]) @map("zone_codes")
  topics          String[]                @default([])
  alertCategories String[]                @default([]) @map("alert_categories")
  contentHash     String                  @map("content_hash")
  status          AssistantDocumentStatus @default(PUBLISHED)
  reviewedBy      String?                 @map("reviewed_by")
  reviewedAt      DateTime?               @map("reviewed_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  chunks AssistantChunk[]

  @@index([status])
  @@map("assistant_document")
}

// Extrait d'une fiche. La colonne embedding (vector, dimension fixée par la migration) et son
// index HNSW sont gérés en SQL : les requêtes passent par src/database/sql/assistant.sql.ts.
model AssistantChunk {
  id             String                       @id @default(uuid(7)) @db.Uuid
  documentId     String                       @map("document_id") @db.Uuid
  document       AssistantDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal        Int
  heading        String
  content        String
  tokenCount     Int                          @map("token_count")
  contentHash    String                       @map("content_hash")
  embedding      Unsupported("vector(1024)")?
  embeddingModel String?                      @map("embedding_model")
  createdAt      DateTime                     @default(now()) @map("created_at")

  @@unique([documentId, ordinal])
  @@map("assistant_chunk")
}

// Conversation : l'auteur n'est gardé que pour « mes questions » ; le journal du ministère ne
// montre que le rôle et la commune. Purge automatique à purge_after.
model AssistantConversation {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role       Role
  communeId  String?  @map("commune_id") @db.Uuid
  commune    Commune? @relation(fields: [communeId], references: [id])
  farmId     String?  @map("farm_id") @db.Uuid
  farm       Farm?    @relation(fields: [farmId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")
  purgeAfter DateTime @map("purge_after")

  messages AssistantMessage[]

  @@index([userId, createdAt])
  @@index([communeId, createdAt])
  @@index([purgeAfter])
  @@map("assistant_conversation")
}

model AssistantMessage {
  id              String                @id @default(uuid(7)) @db.Uuid
  conversationId  String                @map("conversation_id") @db.Uuid
  conversation    AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            AssistantMessageRole
  content         String
  // [{ chunkId, slug, quote }] : extraits cités, vérifiés côté serveur.
  citations       Json?
  confidence      Decimal?              @db.Decimal(4, 3)
  confidenceLabel String?               @map("confidence_label")
  outcome         AssistantOutcome?
  // Identifiant du modèle tel que configuré (variable d'environnement), ou « fixture ».
  modelRef        String?               @map("model_ref")
  latencyMs       Int?                  @map("latency_ms")
  createdAt       DateTime              @default(now()) @map("created_at")

  feedback     AssistantFeedback[]
  agentRequest AssistantAgentRequest?

  @@index([conversationId, createdAt])
  @@index([outcome, createdAt])
  @@map("assistant_message")
}

model AssistantFeedback {
  id        String           @id @default(uuid(7)) @db.Uuid
  messageId String           @map("message_id") @db.Uuid
  message   AssistantMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String?          @map("user_id") @db.Uuid
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  useful    Boolean
  reason    String?
  comment   String?
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([messageId, userId])
  @@map("assistant_feedback")
}

// « Demander à mon agent » : la question et la réponse sont transmises aux agents de la commune.
model AssistantAgentRequest {
  id          String                 @id @default(uuid(7)) @db.Uuid
  messageId   String                 @unique @map("message_id") @db.Uuid
  message     AssistantMessage       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  communeId   String                 @map("commune_id") @db.Uuid
  commune     Commune                @relation(fields: [communeId], references: [id])
  status      AssistantRequestStatus @default(OPEN)
  handledById String?                @map("handled_by_id") @db.Uuid
  handledBy   User?                  @relation(fields: [handledById], references: [id], onDelete: SetNull)
  handledAt   DateTime?              @map("handled_at")
  createdAt   DateTime               @default(now()) @map("created_at")

  @@index([communeId, status, createdAt])
  @@map("assistant_agent_request")
}

// ---------------------------------------------------------------------------
// Tableau de bord national (étape 7)
// ---------------------------------------------------------------------------

// Dernier rafraîchissement de chaque vue matérialisée d'agrégats. Les vues elles-mêmes
// (mv_crop_stats_by_commune, mv_farm_stats_by_commune) sont en SQL pur dans la migration
// analytics_views, lues par $queryRaw : Prisma ne représente pas les vues matérialisées.
model AnalyticsRefresh {
  viewName    String   @id @map("view_name")
  refreshedAt DateTime @map("refreshed_at")
  durationMs  Int      @map("duration_ms")
  rowCount    Int      @map("row_count")

  @@map("analytics_refresh")
}

// ---------------------------------------------------------------------------
// Signalements de terrain (phase 0, docs/modules/signalements.md)
// ---------------------------------------------------------------------------

enum FieldReportType {
  PEST
  CROP_DISEASE
  ANIMAL_DISEASE
  OTHER
}

enum FieldReportStatus {
  SUBMITTED
  CONFIRMED
  DISMISSED
}

// Problème signalé sur une parcelle ou une exploitation par le producteur (ou l'agent qui l'a
// enregistrée) : ravageur, maladie des cultures, maladie animale. Déclaratif tant qu'un agent ne
// l'a pas confirmé sur place. Un signalement isolé n'est jamais une alerte : seul un regroupement
// de signalements du même type, dans la même zone et sur une période courte, en lève une
// (ADR-0015). L'identifiant vient de l'appareil (UUID v7), pour la saisie hors ligne.
model FieldReport {
  id             String                                 @id @db.Uuid
  farmId         String                                 @map("farm_id") @db.Uuid
  farm           Farm                                   @relation(fields: [farmId], references: [id])
  parcelId       String?                                @map("parcel_id") @db.Uuid
  parcel         Parcel?                                @relation(fields: [parcelId], references: [id])
  // Commune de l'exploitation, recopiée pour les filtres territoriaux et la détection.
  communeId      String                                 @map("commune_id") @db.Uuid
  commune        Commune                                @relation(fields: [communeId], references: [id])
  type           FieldReportType
  cropCode       String?                                @map("crop_code")
  description    String
  // Point retenu pour la détection : GPS de l'appareil s'il a été relevé, sinon centre de la
  // parcelle, sinon position de l'exploitation (location_source). Écrit par PostGIS.
  location       Unsupported("geography(Point, 4326)")?
  locationSource String                                 @map("location_source")
  gpsAccuracyM   Decimal?                               @map("gps_accuracy_m") @db.Decimal(8, 1)
  observedAt     DateTime                               @map("observed_at")
  reportedById   String                                 @map("reported_by_id") @db.Uuid
  reportedBy     User                                   @relation("fieldReportAuthor", fields: [reportedById], references: [id])
  status         FieldReportStatus                      @default(SUBMITTED)
  reviewedById   String?                                @map("reviewed_by_id") @db.Uuid
  reviewedBy     User?                                  @relation("fieldReportReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?                              @map("reviewed_at")
  reviewNote     String?                                @map("review_note")
  photo          FieldReportPhoto?
  createdAt      DateTime                               @default(now()) @map("created_at")
  updatedAt      DateTime                               @updatedAt @map("updated_at")

  @@index([communeId, type, observedAt])
  @@index([farmId, createdAt])
  @@index([status, createdAt])
  @@map("field_report")
}

// Photo facultative d'un signalement, réencodée en WebP sans métadonnées (EXIF, position de
// l'appareil) avant stockage. En base faute de stockage objet dans le projet : à déplacer vers un
// stockage objet avant un déploiement à grande échelle (ADR-0015).
model FieldReportPhoto {
  reportId    String      @id @map("report_id") @db.Uuid
  report      FieldReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  contentType String      @map("content_type")
  width       Int
  height      Int
  bytes       Bytes
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("field_report_photo")
}

// ---------------------------------------------------------------------------
// Vue du ciel : imagerie Sentinel-2 du Copernicus Data Space Ecosystem (ADR-0016)
// ---------------------------------------------------------------------------

enum SatelliteLayer {
  TRUE_COLOR
  NDVI
  // Carte des cultures par satellite (ADR-0021).
  CROP_CLASSES
}

// Cache des images calculées par Copernicus, pour ne pas épuiser le quota gratuit (10 000
// requêtes par mois) : une tuile demandée une fois n'est plus redemandée. `tile_key` vaut
// « z/x/y » pour une tuile de 512 px, « overview » pour l'image d'ensemble du pays. Un mois
// révolu ne change plus (cache sans échéance) ; le mois en cours expire pour prendre les
// nouveaux passages. `image` nulle : zone sans donnée, mémorisée pour ne pas redemander.
model SatelliteTile {
  layer     SatelliteLayer
  period    String
  tileKey   String         @map("tile_key")
  image     Bytes?
  fetchedAt DateTime       @default(now()) @map("fetched_at")
  expiresAt DateTime?      @map("expires_at")

  @@id([layer, period, tileKey])
  @@map("satellite_tile")
}

// Décompte mensuel des requêtes envoyées aux API de traitement CDSE (mois AAAA-MM, UTC) : le
// plafond SATELLITE_MONTHLY_REQUEST_BUDGET est vérifié avant chaque appel, dans la même
// requête SQL que l'incrément.
model SatelliteUsage {
  month              String   @id
  imageRequests      Int      @default(0) @map("image_requests")
  statisticsRequests Int      @default(0) @map("statistics_requests")
  // Propositions de contours de champs : part réservée du plafond (SATELLITE_PROPOSAL_SHARE).
  proposalRequests   Int      @default(0) @map("proposal_requests")
  // Limiteur global sous le plafond Copernicus de 300 requêtes par minute : minute courante
  // (AAAA-MM-JJTHH:MM, UTC) et requêtes déjà réservées dans cette minute.
  minuteBucket       String?  @map("minute_bucket")
  minuteRequests     Int      @default(0) @map("minute_requests")
  processingUnits    Decimal  @default(0) @map("processing_units") @db.Decimal(12, 3)
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("satellite_usage")
}

// ---------------------------------------------------------------------------
// Demandes d'assistance « Solliciter l'État » (phase 0, docs/modules/signalements.md)
// ---------------------------------------------------------------------------

enum AssistanceCategory {
  ADVICE
  INPUT
  DISPUTE
  DISASTER
  OTHER
}

enum AssistanceStatus {
  RECEIVED
  IN_PROGRESS
  RESOLVED
}

// Demande d'un producteur à l'État (conseil, intrant, litige, sinistre), routée vers les agents de
// sa commune. Suivie des deux côtés : reçue, prise en charge par un agent, résolue. Le ministère
// n'en voit que les volumes et les délais par commune, avec le masquage des petits effectifs.
// L'identifiant vient de l'appareil (saisie hors ligne).
model AssistanceRequest {
  id             String             @id @db.Uuid
  requesterId    String             @map("requester_id") @db.Uuid
  requester      User               @relation("assistanceRequester", fields: [requesterId], references: [id])
  farmId         String?            @map("farm_id") @db.Uuid
  farm           Farm?              @relation(fields: [farmId], references: [id])
  communeId      String             @map("commune_id") @db.Uuid
  commune        Commune            @relation(fields: [communeId], references: [id])
  category       AssistanceCategory
  description    String
  status         AssistanceStatus   @default(RECEIVED)
  handledById    String?            @map("handled_by_id") @db.Uuid
  handledBy      User?              @relation("assistanceHandler", fields: [handledById], references: [id])
  takenAt        DateTime?          @map("taken_at")
  resolvedAt     DateTime?          @map("resolved_at")
  resolutionNote String?            @map("resolution_note")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@index([communeId, status, createdAt])
  @@index([requesterId, createdAt])
  @@map("assistance_request")
}

enum VegetationCheckStatus {
  CONSISTENT
  TO_VERIFY
  INSUFFICIENT_DATA
  PENDING
}

// Confrontation déclaration / satellite (ADR-0016) : NDVI de la parcelle sur la saison, calculé
// par Copernicus (API Statistical), jugé face au profil attendu de la culture principale
// déclarée. Une ligne par parcelle, campagne et sous-saison, recalculée tant que la saison n'est
// pas jugée. `series` garde les valeurs par décade pour l'affichage et l'audit ; `reason` vaut
// LOW_PEAK, NO_CYCLE ou LOW_COVER quand le statut est TO_VERIFY.
model ParcelVegetationCheck {
  id             String                @id @default(uuid(7)) @db.Uuid
  parcelId       String                @map("parcel_id") @db.Uuid
  parcel         Parcel                @relation(fields: [parcelId], references: [id])
  campaignId     String                @map("campaign_id") @db.Uuid
  campaign       AgriculturalCampaign  @relation(fields: [campaignId], references: [id])
  subSeason      SubSeason             @map("sub_season")
  cropId         String                @map("crop_id") @db.Uuid
  crop           Crop                  @relation(fields: [cropId], references: [id])
  status         VegetationCheckStatus
  reason         String?
  peakNdvi       Decimal?              @map("peak_ndvi") @db.Decimal(4, 3)
  baseNdvi       Decimal?              @map("base_ndvi") @db.Decimal(4, 3)
  expectedNdvi   Decimal               @map("expected_ndvi") @db.Decimal(4, 3)
  validIntervals Int                   @map("valid_intervals")
  windowFrom     DateTime              @map("window_from") @db.Date
  windowTo       DateTime              @map("window_to") @db.Date
  series         Json
  // Capteur qui a tranché : S2 (NDVI, source principale) ou S1 (radar, seulement quand les
  // nuages ont empêché Sentinel-2 de conclure, ADR-0019). La série radar est gardée à part.
  sensor         String                @default("S2")
  radarSeries    Json?                 @map("radar_series")

  sourceId    String      @map("source_id")
  source      DataSource  @relation(fields: [sourceId], references: [id])
  reliability Reliability
  computedAt  DateTime    @default(now()) @map("computed_at")

  @@unique([parcelId, campaignId, subSeason])
  @@index([campaignId, status])
  @@map("parcel_vegetation_check")
}

// ---------------------------------------------------------------------------
// Suivi du producteur sur WhatsApp et palmarès public (docs/modules/suivi-et-palmares.md)
// ---------------------------------------------------------------------------

enum FarmerNotificationKind {
  ASSISTANCE_TAKEN
  ASSISTANCE_RESOLVED
  REPORT_CONFIRMED
  REPORT_DISMISSED
  // Message du ministère aux membres d'un groupe de producteurs (ADR-0024).
  GROUP_MESSAGE
}

// Message de suivi adressé au producteur sur WhatsApp : demande d'assistance prise en charge ou
// résolue, signalement confirmé ou écarté. Écrit dans la même transaction que le changement de
// statut, envoyé ensuite, sous réserve de son consentement au moment de l'envoi. Un seul message
// par événement (type, demande ou signalement). Pour un message de groupe, l'événement est le
// couple (message, producteur) : `subject_id` est un UUID v5 dérivé des deux (ADR-0024).
model FarmerNotification {
  id                String                 @id @default(uuid(7)) @db.Uuid
  farmerId          String                 @map("farmer_id") @db.Uuid
  farmer            Farmer                 @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  kind              FarmerNotificationKind
  subjectId         String                 @map("subject_id") @db.Uuid
  text              String
  status            DeliveryStatus         @default(PENDING)
  attempts          Int                    @default(0)
  nextAttemptAt     DateTime?              @map("next_attempt_at")
  sentAt            DateTime?              @map("sent_at")
  providerMessageId String?                @map("provider_message_id")
  failureReason     String?                @map("failure_reason")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@unique([kind, subjectId])
  @@index([status, nextAttemptAt])
  @@index([farmerId, createdAt])
  @@map("farmer_notification")
}

// Accord du producteur pour figurer dans les palmarès publiés (complément d'ADR-0018), donné et
// retiré par lui-même depuis son compte. Le retirer l'efface aussitôt des palmarès publiés.
model RankingConsent {
  farmerId    String    @id @map("farmer_id") @db.Uuid
  farmer      Farmer    @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  grantedAt   DateTime  @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")
  // Version du texte accepté (preuve APDP) ; nulle pour un accord antérieur au suivi des versions.
  textVersion String?   @map("text_version")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("ranking_consent")
}

// Palmarès publié par le ministère : instantané des premiers lauréats consentants pour des
// critères donnés (culture, campagne, territoire, mesure). Retiré, il quitte la page publique.
model PublishedRanking {
  id              String                  @id @default(uuid(7)) @db.Uuid
  title           String
  cropCode        String                  @map("crop_code")
  campaignCode    String                  @map("campaign_code")
  departementCode String?                 @map("departement_code")
  communeCode     String?                 @map("commune_code")
  metric          String
  verifiedOnly    Boolean                 @map("verified_only")
  requestedCount  Int                     @map("requested_count")
  publishedById   String                  @map("published_by_id") @db.Uuid
  publishedBy     User                    @relation("rankingPublisher", fields: [publishedById], references: [id])
  publishedAt     DateTime                @default(now()) @map("published_at")
  withdrawnAt     DateTime?               @map("withdrawn_at")
  withdrawnById   String?                 @map("withdrawn_by_id") @db.Uuid
  withdrawnBy     User?                   @relation("rankingWithdrawer", fields: [withdrawnById], references: [id])
  entries         PublishedRankingEntry[]

  @@index([withdrawnAt, publishedAt])
  @@map("published_ranking")
}

// Lauréat d'un palmarès publié, recopié au moment de la publication. Jamais de téléphone ni de
// NPI : nom, commune, rang dans le classement complet et chiffres de la campagne.
model PublishedRankingEntry {
  rankingId       String           @map("ranking_id") @db.Uuid
  ranking         PublishedRanking @relation(fields: [rankingId], references: [id], onDelete: Cascade)
  rank            Int
  farmerId        String           @map("farmer_id") @db.Uuid
  farmer          Farmer           @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  displayName     String           @map("display_name")
  communeName     String           @map("commune_name")
  departementName String           @map("departement_name")
  productionT     Decimal          @map("production_t") @db.Decimal(12, 3)
  areaHa          Decimal          @map("area_ha") @db.Decimal(10, 3)

  @@id([rankingId, rank])
  @@index([farmerId])
  @@map("published_ranking_entry")
}

// ---------------------------------------------------------------------------
// Groupes de producteurs (ADR-0024)
// ---------------------------------------------------------------------------

// Groupe formé par le ministère à partir du palmarès : « les 100 meilleurs producteurs de coton
// du Borgou, campagne 2024-2025 ». Les membres sont recalculés côté serveur avec les critères
// enregistrés, jamais repris d'une liste envoyée par le navigateur. Archivé, le groupe reste
// consultable mais ne reçoit plus de message.
model ProducerGroup {
  id            String                 @id @default(uuid(7)) @db.Uuid
  name          String
  cropId        String                 @map("crop_id") @db.Uuid
  crop          Crop                   @relation(fields: [cropId], references: [id])
  campaignId    String                 @map("campaign_id") @db.Uuid
  campaign      AgriculturalCampaign   @relation(fields: [campaignId], references: [id])
  departementId String?                @map("departement_id") @db.Uuid
  departement   Departement?           @relation(fields: [departementId], references: [id])
  // Critères du palmarès utilisés (culture, campagne, territoire, mesure, vérification, nombre).
  criteria      Json
  createdById   String                 @map("created_by_id") @db.Uuid
  createdBy     User                   @relation("producerGroupCreator", fields: [createdById], references: [id])
  createdAt     DateTime               @default(now()) @map("created_at")
  archivedAt    DateTime?              @map("archived_at")
  members       ProducerGroupMember[]
  messages      ProducerGroupMessage[]

  @@index([archivedAt, createdAt])
  @@map("producer_group")
}

// Membre d'un groupe, avec ses chiffres de la campagne au moment de la formation du groupe.
model ProducerGroupMember {
  groupId     String        @map("group_id") @db.Uuid
  group       ProducerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  farmerId    String        @map("farmer_id") @db.Uuid
  farmer      Farmer        @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  // Rang dans le palmarès complet, au moment de la formation.
  rank        Int
  // Nul si la surface cultivée est nulle.
  yieldTPerHa Decimal?      @map("yield_t_per_ha") @db.Decimal(8, 3)
  producedKg  Decimal       @map("produced_kg") @db.Decimal(14, 2)
  areaHa      Decimal       @map("area_ha") @db.Decimal(10, 3)
  // Toutes ses exploitations comptées étaient vérifiées (agent ou terrain).
  verified    Boolean

  @@id([groupId, farmerId])
  @@unique([groupId, rank])
  @@index([farmerId])
  @@map("producer_group_member")
}

// Message WhatsApp adressé par le ministère aux membres d'un groupe. Une notification
// GROUP_MESSAGE est mise en file par membre consentant ; `recipients` en garde le nombre.
model ProducerGroupMessage {
  id         String        @id @default(uuid(7)) @db.Uuid
  groupId    String        @map("group_id") @db.Uuid
  group      ProducerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  text       String
  recipients Int
  sentById   String        @map("sent_by_id") @db.Uuid
  sentBy     User          @relation("producerGroupMessageSender", fields: [sentById], references: [id])
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([groupId, createdAt])
  @@map("producer_group_message")
}

// Classes de la carte des cultures par satellite (ADR-0021).
enum CropMapClass {
  UNCLASSIFIED
  RICE
  ANNUAL
  COTTON
  PERENNIAL
  GARDEN
  FALLOW
  NATURAL
  WATER
  BUILT
}

// Surfaces estimées par satellite, par commune, campagne et classe (ADR-0021) : histogramme de la
// classification phénologique calculée par Copernicus, pixels de `resolution_m` mètres. Une
// estimation, à confirmer : la vue du ministère la compare aux surfaces déclarées au registre.
// `pixel_share` : part des pixels de la commune dans la classe ; `unclassified_share` : part
// restée sans classe (nuages persistants), la même pour toutes les lignes d'une commune.
model CropAreaEstimate {
  id                String               @id @default(uuid(7)) @db.Uuid
  communeId         String               @map("commune_id") @db.Uuid
  commune           Commune              @relation(fields: [communeId], references: [id])
  campaignId        String               @map("campaign_id") @db.Uuid
  campaign          AgriculturalCampaign @relation(fields: [campaignId], references: [id])
  cropClass         CropMapClass         @map("crop_class")
  areaHa            Decimal              @map("area_ha") @db.Decimal(12, 2)
  pixelShare        Decimal              @map("pixel_share") @db.Decimal(6, 4)
  unclassifiedShare Decimal              @map("unclassified_share") @db.Decimal(6, 4)
  resolutionM       Int                  @map("resolution_m")
  windowFrom        DateTime             @map("window_from") @db.Date
  windowTo          DateTime             @map("window_to") @db.Date

  sourceId    String      @map("source_id")
  source      DataSource  @relation(fields: [sourceId], references: [id])
  reliability Reliability
  computedAt  DateTime    @default(now()) @map("computed_at")

  @@unique([communeId, campaignId, cropClass])
  @@index([campaignId, cropClass])
  @@map("crop_area_estimate")
}

// ---------------------------------------------------------------------------
// Feux actifs en quasi temps réel (NASA FIRMS, ADR-0022)
// ---------------------------------------------------------------------------

enum FireSensor {
  VIIRS_SNPP
  VIIRS_NOAA20
  VIIRS_NOAA21
  MODIS
}

enum FireConfidence {
  LOW
  NOMINAL
  HIGH
}

// Feu actif vu par satellite sur le territoire du Bénin. Les détections d'un même feu par
// plusieurs satellites au même passage (375 m, une heure) n'en font qu'une, avec la liste des
// capteurs. Heure d'acquisition en UTC (affichée à l'heure de Porto-Novo). Donnée publique,
// sans lien avec une personne.
model FireDetection {
  id          String                                 @id @default(uuid(7)) @db.Uuid
  detectedAt  DateTime                               @map("detected_at")
  latitude    Decimal                                @db.Decimal(8, 5)
  longitude   Decimal                                @db.Decimal(8, 5)
  location    Unsupported("geography(Point, 4326)")?
  communeId   String                                 @map("commune_id") @db.Uuid
  commune     Commune                                @relation(fields: [communeId], references: [id])
  sensors     FireSensor[]
  confidence  FireConfidence
  frpMw       Decimal?                               @map("frp_mw") @db.Decimal(9, 2)
  brightnessK Decimal?                               @map("brightness_k") @db.Decimal(6, 2)
  daynight    String?
  // Lignes FIRMS déjà fusionnées (capteur, heure, position) : un fichier relu ne crée rien.
  sourceKeys  String[]                               @map("source_keys")
  createdAt   DateTime                               @default(now()) @map("created_at")
  updatedAt   DateTime                               @updatedAt @map("updated_at")

  @@index([detectedAt])
  @@index([communeId, detectedAt])
  @@map("fire_detection")
}

// Passage de la tâche d'ingestion des feux (toutes les 30 minutes) : fraîcheur de la source.
model FireIngestionRun {
  id          String          @id @default(uuid(7)) @db.Uuid
  startedAt   DateTime        @default(now()) @map("started_at")
  finishedAt  DateTime?       @map("finished_at")
  status      IngestionStatus @default(RUNNING)
  fetched     Int             @default(0)
  created     Int             @default(0)
  merged      Int             @default(0)
  failedFiles String[]        @map("failed_files")
  error       String?

  @@index([startedAt])
  @@map("fire_ingestion_run")
}
