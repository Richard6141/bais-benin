{
  "name": "bais",
  "version": "0.1.0",
  "private": true,
  "description": "Bénin Agricultural Intelligence System — plateforme nationale de données agricoles",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "admin:compte": "tsx scripts/admin-accounts.ts",
    "e2e:clean": "tsx scripts/e2e-clean.ts clean",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:purge": "tsx src/modules/privacy/run-purge.ts",
    "db:reference:population": "tsx scripts/load-population.ts",
    "db:demo:survey": "tsx scripts/reseed-demo-survey.ts",
    "db:rules:default": "tsx scripts/load-default-rules.ts",
    "db:reference:fires-archive": "tsx scripts/load-fire-archive.ts",
    "prepare": "husky",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "postinstall": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.55",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@serwist/turbopack": "9.5.12",
    "ai": "7.0.114",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.2.0",
    "libphonenumber-js": "1.12.13",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "6.11.2",
    "motion": "^13.4.3",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "serwist": "9.5.12",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.3.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.10",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "fake-indexeddb": "6.2.2",
    "husky": "^9.1.7",
    "hyparquet": "^1.31.1",
    "hyparquet-compressors": "^1.1.2",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
