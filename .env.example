# Copier vers .env et renseigner les valeurs. Aucune valeur réelle ne doit être versionnée.

# --- Application ---
NODE_ENV=development
# development | test | demo | staging | production (production refuse les comptes de démonstration)
APP_ENV=development
APP_URL=http://localhost:3000

# --- Base de données (PostgreSQL 16 + PostGIS + pgvector) ---
# Format : postgresql://utilisateur:motdepasse@hote:port/base?schema=public
DATABASE_URL=

# --- Docker Compose (service db) ---
# Port exposé sur la machine hôte. Choisir 5433 si un PostgreSQL local occupe déjà 5432.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# --- Journalisation ---
# trace | debug | info | warn | error
LOG_LEVEL=info

# --- Authentification ---
# Secret de signature des sessions (32 caractères minimum) : openssl rand -base64 48
# Obligatoire dès que NODE_ENV=production (voir lib/env.ts, lib/auth/auth.ts).
AUTH_SECRET=
# Code à usage unique fixe (6 chiffres), valable uniquement pour les numéros exacts des comptes
# de démonstration (lib/auth/demo-accounts.ts, isDemoPhone) ; renseigné, il fait aussi afficher
# ces comptes sous le formulaire de connexion. Interdit en production.
OTP_DEMO_CODE=
# « 0 » masque la liste des comptes de démonstration sous le formulaire de connexion (le code reste
# valable pour ces numéros). Vide : liste affichée hors production.
DEMO_SIGNIN_PANEL=
# Adresses IP ou plages CIDR des relais inverses de confiance placés devant l'application
# (nginx du docker-compose fourni, par exemple), séparées par des virgules. Laisser vide en
# accès direct sans relais (développement).
TRUSTED_PROXIES=

# --- Messagerie (codes à usage unique, alertes) ---
# console (code écrit dans les journaux, rien n'est envoyé) | wapy (envoi réel sur WhatsApp par
# wapy.pro, seul canal admis en production) | fixture (tests). Pour recevoir de vrais codes en
# local : MESSAGING_PRIMARY_CHANNEL=wapy et WAPY_API_KEY renseignée dans .env, jamais ici.
MESSAGING_PRIMARY_CHANNEL=console
WAPY_API_URL=https://wapy.pro
WAPY_API_KEY=
WAPY_WEBHOOK_SECRET=

# Monitoring : open-meteo (réseau, sans clé) ou fixture (démonstration hors réseau).
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com
# Secret du déclenchement planifié de l'ingestion météo (32 caractères au moins).
CRON_SECRET=

# Feux actifs (ADR-0022) : firms (fichiers publics NASA FIRMS, sans clé) ou fixture (hors réseau).
FIRE_PROVIDER=firms
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov

# --- Vue du ciel : Copernicus Data Space Ecosystem (ADR-0016) ---
# cdse (défaut) : catalogue STAC public ; images et NDVI avec un client OAuth du compte CDSE
# gratuit. fixture : séries NDVI synthétiques, sans réseau ni image.
SATELLITE_PROVIDER=cdse
# Client OAuth créé dans le tableau de bord CDSE (User Settings > OAuth clients). Ne jamais
# versionner les valeurs.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Plafond mensuel de requêtes de traitement (quota gratuit : 10 000 par mois).
SATELLITE_MONTHLY_REQUEST_BUDGET=9000
# Parts étanches de ce plafond : propositions de contours (0,3) et statistiques de la
# confrontation (0,5) ; les images de la carte ont le reste. Leur somme ne dépasse pas 1.
SATELLITE_PROPOSAL_SHARE=0.3
SATELLITE_STATISTICS_SHARE=0.5
# Unités de traitement par mois (quota gratuit : 10 000) et requêtes par minute (Copernicus : 300).
SATELLITE_MONTHLY_UNIT_BUDGET=9000
SATELLITE_REQUESTS_PER_MINUTE=250
# Radar Sentinel-1 quand les nuages empêchent Sentinel-2 de conclure (1 : activé). À activer
# après mesure du coût : POST /api/v1/satellite/radar-calibration.
SATELLITE_RADAR_FALLBACK=0
# Riz par radar Sentinel-1 dans les surfaces par commune (1 : activé), environ 2 unités de plus
# par commune. À activer après une mesure réelle : POST /api/v1/satellite/crop-areas?limit=2.
SATELLITE_RADAR_RICE=0
# Classe de la carte aux points d'enquête (ADR-0033, 1 : activé), environ 0,16 unité par point.
# À activer après accord, et une mesure réelle : POST /api/v1/satellite/survey-frame?limit=5.
SURVEY_MAP_READS=0
# Communes pilotes des cultures par parcelle (ADR-0030) : Tchaourou, Tanguiéta, Bassila, Ouèssè,
# Ségbana. Seules leurs parcelles sont lues par satellite (environ 0,7 unité par parcelle).
# Plafond mensuel des lectures de séries de parcelles, en unités de traitement (ADR-0031).
CROP_MODEL_MONTHLY_UNIT_CAP=600
CROP_MODEL_PILOT_COMMUNES=BJ-BOR-008,BJ-ATA-008,BJ-DON-001,BJ-COL-004,BJ-ALI-006
# Tuiles détaillées nouvelles (absentes du cache) qu'un même compte peut demander par mois.
SATELLITE_TILE_MISSES_PER_ACCOUNT=400

# --- NPI (ANIP) ---
# Deux clés distinctes de 32 octets en base64 : openssl rand -base64 32
# Indispensables à toute connexion, développement compris (NPI saisi à la connexion, ADR-0012).
NPI_ENCRYPTION_KEY=
NPI_HASH_KEY=
# Longueur attendue du NPI (13 selon les sources disponibles, paramétrable).
NPI_LENGTH=13
# anip-local (contrôle de forme) | anip-xroad (convention ANIP via X-Road BJ)
IDENTITY_VERIFICATION_PROVIDER=anip-local
ANIP_XROAD_SECURITY_SERVER_URL=
ANIP_XROAD_CLIENT_ID=
ANIP_XROAD_SERVICE_ID=

# --- Journal d'audit ---
# Clé du HMAC qui remplace un hachage simple de l'adresse IP journalisée (32 octets en
# base64 : openssl rand -base64 32). Obligatoire en production.
AUDIT_IP_HASH_KEY=

# --- Données de démonstration ---
# Nombre d'exploitations synthétiques chargées par le seed (50000 pour le jeu complet).
SEED_FARM_COUNT=5000

# --- Cartographie ---
# Style de fond de carte MapLibre (OpenFreeMap, OpenStreetMap). Auto-hébergeable.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Imagerie aérienne haute résolution au zoom du champ (optionnelle), modèle d'URL de tuiles raster
# {z}/{x}/{y} d'un fournisseur sous licence (orthophotos nationales, ArcGIS Location Platform,
# Mapbox...) et sa mention obligatoire. Sans elles, la vue du ciel reste Sentinel-2 (10 m).
NEXT_PUBLIC_HIRES_TILES_URL=
NEXT_PUBLIC_HIRES_ATTRIBUTION=

# --- Assistant agricole ---
# Sans ASSISTANT_LLM_MODEL : adaptateur de démonstration (réponses extraites des fiches, sans réseau).
# Identifiants de modèle transmis tels quels au SDK d'IA (fournisseur global du SDK, qui lit ses
# propres identifiants d'accès), ou au point d'accès compatible OpenAI de ASSISTANT_LLM_BASE_URL.
ASSISTANT_LLM_MODEL=
ASSISTANT_EMBEDDING_MODEL=
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_API_KEY=
# Dimension des plongements (colonne en base) : 1024.
ASSISTANT_EMBEDDING_DIMENSIONS=1024
# Seuil sous lequel l'assistant répond « je ne dispose pas d'une information fiable ».
ASSISTANT_CONFIDENCE_THRESHOLD=0.6
ASSISTANT_TIMEOUT_MS=20000
# Plafond global de questions par jour, tous utilisateurs confondus.
ASSISTANT_DAILY_LIMIT=2000
