# Environnement de l'application sur le serveur de démonstration : modèle sans aucun secret.
# Le vrai fichier est /opt/bais/app.env (chmod 600), écrit sur le serveur seulement
# (docs/deploiement-demo.md). Les valeurs « <...> » sont générées ou recopiées à l'installation.

# Démonstration : comptes de démonstration acceptés (code fixe), vrais codes WhatsApp pour les
# vrais numéros ; la liste des comptes de démonstration n'est pas affichée sur la page publique.
APP_ENV=demo
APP_URL=https://bais.51-210-108-173.sslip.io
LOG_LEVEL=info
OTP_DEMO_CODE=246810
DEMO_SIGNIN_PANEL=0

# Base du projet compose (service « db », réseau interne).
DATABASE_URL=postgresql://bais:<mot-de-passe-postgres>@db:5432/bais?schema=public

# Secrets propres à ce serveur, générés à l'installation (openssl rand -base64 48 ou 32).
AUTH_SECRET=<48 octets en base64>
CRON_SECRET=<48 octets en base64>
AUDIT_IP_HASH_KEY=<32 octets en base64>
NPI_ENCRYPTION_KEY=<32 octets en base64>
NPI_HASH_KEY=<32 octets en base64>

# Le nginx de l'hôte est le seul relais devant l'application : X-Forwarded-For est crédité.
TRUSTED_PROXIES=127.0.0.1

# Messagerie : vrais messages WhatsApp par wapy.pro.
MESSAGING_PRIMARY_CHANNEL=wapy
WAPY_API_KEY=<recopiée du poste de l'équipe>

# Satellite (Copernicus Data Space) : compte partagé avec l'équipe, budget mensuel réduit ici.
SATELLITE_PROVIDER=cdse
CDSE_CLIENT_ID=<recopié du poste de l'équipe>
CDSE_CLIENT_SECRET=<recopié du poste de l'équipe>
SATELLITE_MONTHLY_REQUEST_BUDGET=4000
SATELLITE_MONTHLY_UNIT_BUDGET=4000

# Base de sondage : aucune lecture de la carte des cultures (pas d’appel Copernicus).
SURVEY_MAP_READS=0
